\begin_deeper
\begin_layout Standard
Για την σύγκριση δύο διαστημάτων 
\begin_inset Formula $a=\left[a_{1},a_{2}\right]$
\end_inset

, 
\begin_inset Formula $b=\left[b_{1},b_{2}\right]$
\end_inset

 γίνεται χρήση της συνάρτησης 
\begin_inset Formula 
\begin{eqnarray}
L^{*}(a,b) & = & \begin{cases}
\mbox{TRUE}, & a_{1}<b_{1},\mbox{OR\ \ensuremath{\left(a_{1}=b_{1}\ \mbox{AND}\ a_{2}<b_{2}\right)}}\\
\mbox{FALSE}, & \mbox{\mbox{OTHERWISE}}
\end{cases}\label{eq:eql}
\end{eqnarray}

\end_inset

Μετατροπή της συνάρτησης σφάλματος σε συνάρτηση διαστημάτων:
\begin_inset Formula 
\begin{equation}
[E_{min},E_{max}]=E\left(N\left(\overrightarrow{x},\overrightarrow{W}\right)\right)=\sum_{i=1}^{M}\left(N\left(\overrightarrow{x}_{i},\overrightarrow{W}\right)-y_{i}\right)^{2}\label{eq:eq1interval}
\end{equation}

\end_inset


