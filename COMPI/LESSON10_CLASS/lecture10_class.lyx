\begin_layout Frame
\begin_inset Argument 4
status open

\begin_layout Plain Layout
Χρήση κανόνων διαμέρισης
\end_layout

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Έστω η συνάρτηση: 
\begin_inset Formula 
\begin{equation}
f:S\rightarrow R,S\subset R^{n},\ S=\left[a_{1},b_{1}\right]\otimes\left[a_{2},b_{2}\right]\otimes\ldots\left[a_{n},b_{n}\right]\label{eq:f_eq-1}
\end{equation}

\end_inset


\end_layout

\begin_layout Itemize
Ορισμός του συνόλου 
\begin_inset Formula $I_{n}$
\end_inset

:
\begin_inset Formula 
\begin{equation}
I_{n}=\left\{ \left(l_{1},r_{1}\right),\left(l_{2},r_{2}\right),\ldots,\left(l_{n},r_{n}\right)\right\} \label{eq:I_eq}
\end{equation}

\end_inset

με 
\begin_inset Formula $l_{i}\in\left\{ 0,1\right\} ,\ r_{i}\in\left\{ 0,1\right\} ,\ i=1,\ldots,n$
\end_inset

.
 
\end_layout

\begin_layout Itemize
Αν 
\begin_inset Formula $l_{i}=1$
\end_inset

 τότε 
\begin_inset Formula $a_{i}=\frac{a_{i}}{2}$
\end_inset

 και αν 
\begin_inset Formula $r_{i}=1$
\end_inset

 then 
\begin_inset Formula $b_{i}=\frac{b_{i}}{2}$
\end_inset

.
 
\end_layout

\begin_layout Itemize
Στην συνέχεια ορίζουμε το σύνολο 
\begin_inset Formula $R_{Kn}$
\end_inset

 σαν σειρά κανόνων διαμέρισης
\begin_inset Formula 
\begin{equation}
R_{Kn}=\left\{ I_{n}^{(1)},I_{n}^{(2)},\ldots,I_{n}^{(K)}\right\} \label{eq:ck}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\end_deeper
\begin_layout PlainFrame
\begin_inset Argument 4
status open

\begin_layout Plain Layout
Παράδειγμα εφαρμογής
\end_layout

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Για παράδειγμα η συνάρτηση Rastrigin : 
\begin_inset Formula 
\begin{equation}
f(x)=x_{1}^{2}+x_{2}^{2}-\cos\left(18x_{1}\right)-\cos\left(18x_{2}\right),\ x\in[-1,1]^{2}
\end{equation}

\end_inset


\end_layout

\begin_layout Itemize
Έστω το σύνολο 
\begin_inset Formula $I_{2}=\left\{ \left(1,0\right),\left(0,1\right)\right\} $
\end_inset

 Το παραγόμενο διάστημα τιμών είναι: 
\begin_inset Formula $S'=\left[-0.5,1\right]\times\left[-1,0.5\right]$
\end_inset

.
\end_layout

\begin_layout Itemize
Εστω πως 
\begin_inset Formula $K=2$
\end_inset

 και έστω 
\begin_inset Formula $R_{22}=\left\{ \left\{ \left(0,1\right),\left(1,0\right)\right\} ,\left\{ \left(1,0\right),\left(1,1\right)\right\} \right\} $
\end_inset

.
 Μετά από πράξεις το τελικό διάστημα τιμών θα είναι:
\end_layout

