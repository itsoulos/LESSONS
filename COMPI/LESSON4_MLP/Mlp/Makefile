####### Compile

main.o: main.cpp neural.h \
		dataset.h \
		problem.h \
		statistics.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

dataset.o: dataset.cpp dataset.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o dataset.o dataset.cpp

gradientdescent.o: gradientdescent.cpp gradientdescent.h \
		problem.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o gradientdescent.o gradientdescent.cpp

gradientwithls.o: gradientwithls.cpp gradientwithls.h \
		gradientdescent.h \
		problem.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o gradientwithls.o gradientwithls.cpp

neural.o: neural.cpp neural.h \
		dataset.h \
		problem.h \
		gradientdescent.h \
		gradientwithls.h \
		simanmethod.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o neural.o neural.cpp

problem.o: problem.cpp problem.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o problem.o problem.cpp

simanmethod.o: simanmethod.cpp simanmethod.h \
		problem.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o simanmethod.o simanmethod.cpp

statistics.o: statistics.cpp statistics.h \
		neural.h \
		dataset.h \
		problem.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o statistics.o statistics.cpp

