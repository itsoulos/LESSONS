####### Compile

main.o: main.cpp rbf.h \
		dataset.h \
		kmeans.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

dataset.o: dataset.cpp dataset.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o dataset.o dataset.cpp

rbf.o: rbf.cpp rbf.h \
		dataset.h \
		kmeans.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o rbf.o rbf.cpp

kmeans.o: kmeans.cpp kmeans.h \
		dataset.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o kmeans.o kmeans.cpp

####### Install

install:  FORCE

uninstall:  FORCE

